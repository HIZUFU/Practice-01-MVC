@model ProductCatalogApp.Models.ProductionSite
@{ ViewData["Title"] = "Добавление"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Create" method="post" class="col-md-6">
<div asp-validation-summary="All" class="text-danger"></div>

<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /><span asp-validation-for="Description" class="text-danger"></span></div>
<button class="btn btn-primary">Сохранить</button> <a asp-action="Index">К списку</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
