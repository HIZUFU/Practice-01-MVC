@model ProductCatalogApp.Models.ProductionSite
@{ ViewData["Title"] = "Просмотр"; }
<h1>@Model.Name</h1><dl><dt>Название</dt><dd>@Model.Name</dd><dt>Описание</dt><dd>@Model.Description</dd></dl>
<h2>Оборудование участка</h2><ul>@foreach (var item in Model.EquipmentItems) { <li>@item.Name — @item.Model (@item.InventoryNumber)</li> }</ul>
@if (true) { <a asp-action="Edit" asp-route-id="@Model.Id">Изменить</a> } <a asp-action="Index">К списку</a>
