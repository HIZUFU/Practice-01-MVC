@model IEnumerable<ProductCatalogApp.Models.ProductionSite>
@{ ViewData["Title"] = "Производственные участки"; }
<h1>Производственные участки</h1>
@if (true) { <p><a asp-action="Create" class="btn btn-primary">Добавить</a></p> }
<form method="get" class="d-flex align-items-center gap-2 mb-3"><input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Название участка" aria-label="Название участка" /><button class="btn btn-outline-primary">Найти</button><a asp-action="Index">Сбросить</a></form>
<table class="table"><thead><tr><th>Название</th><th>Описание</th><th>Действия</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.Name</td><td>@item.Description</td><td><a asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
    @if (true) { <text> · </text><a asp-action="Edit" asp-route-id="@item.Id">Изменить</a><text> · </text><a asp-action="Delete" asp-route-id="@item.Id">Удалить</a> }
    </td></tr>
}
</tbody></table>
@if (!Model.Any()) { <p>Ничего не найдено.</p> }
