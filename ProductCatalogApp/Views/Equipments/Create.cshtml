@model ProductCatalogApp.Models.Equipment
@{ ViewData["Title"] = "Добавление"; }
<h1>@ViewData["Title"]</h1>
<form asp-action="Create" method="post" class="col-md-6">
<div asp-validation-summary="All" class="text-danger"></div>

<div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /><span asp-validation-for="Model" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="InventoryNumber" class="form-label"></label><input asp-for="InventoryNumber" class="form-control" /><span asp-validation-for="InventoryNumber" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="ProductionSiteId" class="form-label"></label><select asp-for="ProductionSiteId" asp-items="ViewBag.ProductionSiteId" class="form-select"><option value="0">Выберите участок</option></select><span asp-validation-for="ProductionSiteId" class="text-danger"></span></div>
<button class="btn btn-primary">Сохранить</button> <a asp-action="Index">К списку</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
