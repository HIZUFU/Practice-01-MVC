@model IEnumerable<ProductCatalogApp.Models.Equipment>
@{ ViewData["Title"] = "Оборудование"; }
<h1>Оборудование</h1>
@if (true) { <p><a asp-action="Create" class="btn btn-primary">Добавить</a></p> }
<form method="get" class="d-flex align-items-center gap-2 mb-3"><label for="productionSiteId">Участок</label><select id="productionSiteId" name="productionSiteId" asp-items="ViewBag.ProductionSiteId" class="form-select"><option value="">Все участки</option></select><button class="btn btn-outline-primary">Найти</button><a asp-action="Index">Сбросить</a></form>
<table class="table"><thead><tr><th>Название</th><th>Модель</th><th>Инвентарный номер</th><th>Участок</th><th>Действия</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td>@item.Name</td><td>@item.Model</td><td>@item.InventoryNumber</td><td>@item.ProductionSite?.Name</td><td><a asp-action="Details" asp-route-id="@item.Id">Подробнее</a>
    @if (true) { <text> · </text><a asp-action="Edit" asp-route-id="@item.Id">Изменить</a><text> · </text><a asp-action="Delete" asp-route-id="@item.Id">Удалить</a> }
    </td></tr>
}
</tbody></table>
@if (!Model.Any()) { <p>Ничего не найдено.</p> }
