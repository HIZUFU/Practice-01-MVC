@model ProductCatalogApp.Models.Equipment
@{ ViewData["Title"] = "Просмотр"; }
<h1>@Model.Name</h1><dl><dt>Название</dt><dd>@Model.Name</dd><dt>Модель</dt><dd>@Model.Model</dd><dt>Инвентарный номер</dt><dd>@Model.InventoryNumber</dd><dt>Участок</dt><dd>@Model.ProductionSite?.Name</dd></dl>

@if (true) { <a asp-action="Edit" asp-route-id="@Model.Id">Изменить</a> } <a asp-action="Index">К списку</a>
